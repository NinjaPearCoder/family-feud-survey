# Copy to .env.local and fill in values

# SQLite database file (local dev — path is relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Admin password for the /admin section (at least 12 characters; placeholders are rejected)
ADMIN_PASSWORD="changeme"

# Secret for signing session JWTs (at least 32 random bytes; placeholders are rejected)
SESSION_SECRET="replace-with-a-long-random-string"

# Set false for a local preview without external AI requests
AI_ENABLED="false"

# Provider configuration is server-only. Approve the destination before enabling AI.
AI_PROVIDER="anthropic"
AI_MODEL="claude-opus-4-5"
# For openai-compatible, set AI_BASE_URL to the HTTPS API base (including /v1 if required).
# AI_BASE_URL="https://approved-gateway.example/v1"
# AI_API_KEY=""
# Anthropic credentials (only needed for the anthropic provider)
ANTHROPIC_API_KEY="sk-ant-..."

# Review policy and optional scheduler. Keep off until the provider and data use are approved.
REVIEW_TARGET_RESPONSES="100"
REVIEW_INTERVAL_MINUTES="15"
REVIEW_WORKER_ENABLED="false"
REVIEW_WORKER_INTERVAL_SECONDS="60"
REVIEW_SCHEDULER_SECRET=""

# Public URL of this app (used for QR code generation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

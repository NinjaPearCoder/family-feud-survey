generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Survey {
  id          String    @id @default(cuid())
  title       String
  description String?
  source      String?
  audience    String?
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  openedAt    DateTime?
  closedAt    DateTime?
  archivedAt  DateTime?
  token       String    @unique @default(cuid())
  questions   Question[]
  backgroundVersion Int @default(0)
  backgroundQuestions BackgroundQuestion[]
  responses   Response[]
  reviewLeaseId       String?
  reviewLeaseUntil    DateTime?
  lastReviewAttemptAt DateTime?
  lastReviewError     String?

  @@index([status])
}

model Question {
  id          String       @id @default(cuid())
  surveyId    String
  text        String
  sortOrder   Int
  survey      Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers     Answer[]
  tabulations Tabulation[]
  review      QuestionReview?
  reviewAttemptedAt DateTime?

  @@index([surveyId])
}

model Response {
  id              String   @id @default(cuid())
  surveyId        String
  respondentToken String
  submissionId    String?
  submittedAt     DateTime @default(now())
  survey          Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers         Answer[]
  backgroundAnswers BackgroundAnswer[]

  @@index([surveyId])
  @@unique([surveyId, submissionId])
}

model Answer {
  id         String   @id @default(cuid())
  responseId String
  questionId String
  text       String
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@unique([responseId, questionId])
}

model BackgroundQuestion {
  id          String @id @default(cuid())
  surveyId    String
  label       String
  type        String
  required    Boolean @default(false)
  optionsJson String @default("[]")
  sortOrder   Int
  survey      Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers     BackgroundAnswer[]

  @@index([surveyId])
}

model BackgroundAnswer {
  id         String @id @default(cuid())
  responseId String
  questionId String
  valuesJson String
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   BackgroundQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([questionId])
}

model Tabulation {
  id           String   @id @default(cuid())
  questionId   String
  answerText   String
  count        Int
  qualityScore Float?
  tabulatedAt  DateTime @default(now())
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuestionReview {
  questionId        String   @id
  inputHash         String
  reviewedAt        DateTime @default(now())
  responseCount     Int
  validCount        Int
  flaggedCount      Int
  questionScore     Float
  qualityScore      Float
  sampleScore       Float
  distributionScore Float
  topAnswerShare    Float
  topEightShare     Float
  groupCount        Int
  recommendation    String
  summary           String
  issuesJson        String
  flagsJson         String
  provider          String
  model             String
  question          Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

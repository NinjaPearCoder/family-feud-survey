{
  "name": "feud-survey",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "tsx --test tests/*.test.ts",
    "review:worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/review-worker.mjs",
    "survey:import-livit": "node --env-file-if-exists=.env.local scripts/import-livit-surveys.mjs",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.26.0",
    "@prisma/client": "^5.19.0",
    "jose": "6.2.17",
    "next": "16.4.6",
    "prisma": "^5.19.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.12",
    "typescript": "^5",
    "tsx": "^4.20.0"
  }
}
